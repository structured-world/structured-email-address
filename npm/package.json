{
  "name": "structured-email-address-npm",
  "private": true,
  "description": "Workspace for the @structured-world/structured-email-address npm packages.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "ts",
    "wasm",
    "default"
  ],
  "scripts": {
    "build": "npm run build -w ts -w wasm && npm run build -w default",
    "test": "npm run build && npm run test --workspaces",
    "typecheck": "npm run build && npm run typecheck --workspaces",
    "parity": "node scripts/parity.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/tr46": "^5",
    "tsup": "^8",
    "typescript": "^5.6",
    "vitest": "^3"
  }
}
